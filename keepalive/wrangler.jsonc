{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghostswap-keepalive",
  "main": "index.js",
  "compatibility_date": "2026-08-24",
  "triggers": {
    // cada 6 horas: Supabase pide actividad varias veces al dia, no cada 3 dias.
    // el dia 1 de cada mes: latido de Brevo (ver index.js)
    "crons": ["0 3,9,15,21 * * *", "0 13 1 * *"]
  },
  "observability": { "enabled": true }
}
