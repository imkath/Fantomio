{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghostswap",
  "compatibility_date": "2024-12-30",
  // Static files only (next.config output: 'export'): no Worker script runs, so requests are
  // free, unlimited and can't hit a CPU limit. Headers and redirects: public/_headers and
  // public/_redirects.
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [
    {
      "pattern": "ghostswap.nvrkth.com",
      "custom_domain": true,
    },
  ],
}
